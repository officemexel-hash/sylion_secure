PORT=8080
SYLION_DB_PATH=.data/admin-api.sqlite

# Public customer portal split.
# Set this on both the private admin API and the separate public portal VPS.
# The browser never receives this value; only the portal edge proxy sends it.
SYLION_PUBLIC_PORTAL_SHARED_SECRET=

# Set this only on the public portal VPS.
SYLION_CONTROL_PLANE_BASE_URL=http://10.42.0.10:8080
