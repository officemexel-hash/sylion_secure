# SYLION Puli AX UCI firewall config
# Per ADR-router-phantom-001 §"Mandatory Gates" M3 + warunek C4
# nftables default-deny, kill switch loaded pre-VPN
# DROP > REJECT for stealth (no ICMP responses to scanners)

config defaults
    option syn_flood '1'
    option input 'DROP'
    option output 'DROP'
    option forward 'DROP'
    option drop_invalid '1'
    option flow_offloading '0'
    option flow_offloading_hw '0'

config zone
    option name 'lan'
    list network 'lan'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'REJECT'
    option masq '0'

config zone
    option name 'wan'
    list network 'wan'
    list network 'wwan'
    option input 'DROP'
    option output 'DROP'
    option forward 'DROP'
    option masq '0'
    option mtu_fix '1'

config zone
    option name 'ipsec'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'ACCEPT'
    # Will be populated by strongSwan via XFRM after tunnel up

# LAN can forward through IPsec (after tunnel up)
config forwarding
    option src 'lan'
    option dest 'ipsec'

# IKE traffic on WAN — only thing allowed pre-tunnel
config rule
    option name 'Allow-IKE-IKEv2'
    option src 'wan'
    option proto 'udp'
    option dest_port '500 4500'
    option target 'ACCEPT'
    option family 'ipv4'

config rule
    option name 'Allow-ESP-out'
    option src 'lan'
    option dest 'wan'
    option proto 'esp'
    option target 'ACCEPT'

# DNS leak prevention — drop all DNS to WAN
config rule
    option name 'Drop-DNS-leak-WAN'
    option src 'lan'
    option dest 'wan'
    option proto 'tcpudp'
    option dest_port '53'
    option target 'REJECT'

config rule
    option name 'Drop-DoH-Cloudflare-leak'
    option src 'lan'
    option dest 'wan'
    option dest_ip '1.1.1.1 1.0.0.1 8.8.8.8 8.8.4.4 9.9.9.9'
    option proto 'tcp'
    option dest_port '443 853'
    option target 'REJECT'

# DHCP from upstream — required for WAN bring-up
config rule
    option name 'Allow-DHCP-client'
    option src 'wan'
    option proto 'udp'
    option src_port '67'
    option dest_port '68'
    option target 'ACCEPT'

# No IPv6 forward — IPv6 disabled per network config
config rule
    option name 'Block-IPv6-all'
    option src '*'
    option family 'ipv6'
    option target 'DROP'

# Block LAN → WAN bypass attempts (per M7)
config rule
    option name 'Block-LAN-to-WAN-direct'
    option src 'lan'
    option dest 'wan'
    option target 'REJECT'
    option proto 'all'
